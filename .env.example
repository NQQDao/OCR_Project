# ============================================================
# CẤU HÌNH MÔI TRƯỜNG CHO OCR_PROJECT
# ============================================================

# 1. Kết nối PostgreSQL
# Cục bộ (Local Windows): postgresql://postgres:123321@localhost:5432/ocr_db
# Docker Compose:         postgresql://postgres:123321@db:5432/ocr_db
# Cloud (Render / Neon):  postgresql://user:pass@ep-xyz.neon.tech/ocr_db?sslmode=require
DATABASE_URL=postgresql://postgres:123321@localhost:5432/ocr_db

# 2. Google Gemini API Key (nếu chưa set biến môi trường hệ thống)
# GEMINI_API_KEY=your_gemini_api_key_here

# 3. Web Server
HOST=0.0.0.0
PORT=8000
