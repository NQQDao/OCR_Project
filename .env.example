# ============================================================
# CẤU HÌNH MÔI TRƯỜNG CHO OCR_PROJECT
# ============================================================

# 1. Cơ sở dữ liệu (SQLite hoặc PostgreSQL)
# ------------------------------------------------------------
# [Lựa chọn 1 - Mặc định]: SQLite (Zero-config, chạy ngay không cần cài đặt máy chủ)
DATABASE_URL=sqlite:///./ocr_data.db

# [Lựa chọn 2 - Nâng cao]: PostgreSQL (Chạy server riêng hoặc Docker Compose)
# Cục bộ (Local Windows): DATABASE_URL=postgresql://postgres:123321@localhost:5432/ocr_db
# Docker Compose:         DATABASE_URL=postgresql://postgres:123321@db:5432/ocr_db
# Cloud (Render / Neon):  DATABASE_URL=postgresql://user:pass@ep-xyz.neon.tech/ocr_db?sslmode=require

# 2. Google Gemini API Key & Fallback Models
# ------------------------------------------------------------
# Khóa API Gemini tạo từ Google AI Studio (bắt đầu bằng AIzaSy...)
GEMINI_API_KEY=your_gemini_api_key_here
# Danh sách model Gemini tự động chuyển khi model chính bận/503 (ngăn cách bằng dấu phẩy)
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.8-flash,gemini-3.5-flash,gemini-3.1-pro

# 3. [Tùy chọn] OpenAI / OpenRouter Fallback (Dự phòng chống nghẽn 100%)
# ------------------------------------------------------------
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o-mini
# Nếu dùng OpenRouter thay cho OpenAI trực tiếp:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-v1-...
# OPENAI_MODEL=openai/gpt-4o-mini

# 4. Web Server
HOST=0.0.0.0
PORT=8000

# 4. Lưu trữ đám mây Cloudflare R2 (S3-Compatible) & Cloudflare Worker CDN
# ------------------------------------------------------------
# Lấy từ Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=ocr-wood-storage
# Đường dẫn CDN công khai của Cloudflare Worker sau khi npx wrangler deploy (nếu có)
R2_PUBLIC_URL=https://ocr-r2-worker.<your-subdomain>.workers.dev

# 5. Cơ sở dữ liệu đám mây Cloudflare D1 (Serverless SQL Database)
# ------------------------------------------------------------
# Lấy từ Cloudflare Dashboard -> Storage & Databases -> D1 SQL Database
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_uuid_here
CLOUDFLARE_D1_API_TOKEN=your_cloudflare_api_token_here
